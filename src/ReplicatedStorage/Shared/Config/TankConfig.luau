--!strict
--[[
	TankConfig — садок (Этап 3): слоты, рост цены рыбы, подтверждение продажи, лимит запросов,
	вид рыб в витринах, слово у ведра на пирсе, панель садка и все её тексты.

	Как устроен садок (подробно — scratchpad design.md, §1, §4, §5):
	  • рыба живёт во дворе базы — по одной в витрине Tank.Slots.Slot_1..12 (заполняются по
	    SlotIndex, сначала ближние к воротам); открыто StartSlots витрин, остальные до MaxSlots —
	    «🔒 Закрыто» (их откроет магазин Этапа 5); ведро у места рыбалки (Platform.Bucket) — «вход»
	    садка: над ним слово «🐠 4/6 · +$42/с», всплеск, когда рыба легла, и «+$X» дохода;
	  • пойманная рыба сразу ложится в самую младшую свободную витрину (сервер, TankService);
	    садок полон — рыба сильнее (по доходу) заменяет самую слабую (её продают по текущей цене),
	    слабее — сразу продаётся (TankRules.ChooseReplacement);
	  • цена рыбы растёт линейно ×1 → ×Growth.Cap за Growth.Time секунд в садке (только пока
	    хозяин в игре и у него есть база), потом «МАКС»; доход не растёт;
	  • продать можно из панели садка где угодно (×1) — каждую рыбу в два нажатия: «ТОЧНО?»,
	    второе нажатие считается не раньше ConfirmArm и не позже ConfirmTime секунд.

	Тексты с {полями} заполняет TextUtil.fill(шаблон, { поле = значение }): {new}/{old} — короткие
	имена рыб (FishConfig.ShortName), {price} и {money} — суммы TankRules.FormatMoney («$24»),
	{bonus} — надбавка рынка в процентах (EconomyConfig.MarketRatePct − 100).
	Каждое число времени — на своей строке: тесты подменяют его в тексте модуля (boot с patches).
	Кто дописывает (волны Этапа 3): Display и Pier — мир (TankWorldController, волна 1 B: новые
	числа эффектов — туда же), Panel и тексты панели — панель (TankPanelController, волна 2 D).
	Модуль «чистый» (без require), его читает и сборщик места (tools/builder/gui/Tank.luau).
]]

local TankConfig = {
	StartSlots = 6, -- открыто с самого начала (ряды 1–3 обеих галерей, ближе к воротам)
	MaxSlots = 12, -- витрин во дворе базы; больше не бывает (Этап 5 открывает 7..12)

	-- Рост цены в садке: ×1 → ×Cap линейно за Time секунд (TankRules.Growth), дальше «МАКС».
	Growth = {
		Cap = 3,
		Time = 300,
	},

	-- Продажа — всегда в два нажатия: первое показывает «ТОЧНО?» с кольцом-таймером на
	-- ConfirmTime секунд, второе раньше ConfirmArm секунд не считается (двойной тап не продаёт).
	ConfirmTime = 3,
	ConfirmArm = 0.4,

	-- Лимит запросов игрока к садку (TankSell, кнопки ProximityPrompt и ответы "Denied"):
	-- запас Burst, пополняется Rate в секунду; пустой — запрос молча отбрасывается.
	Requests = {
		Burst = 6,
		Rate = 3,
	},

	-- Номер рыбы в садке игрока: "f1", "f2", … (Prefix + номер, не длиннее MaxLength знаков;
	-- номера не повторяются — PlayerData.NewUid).
	Uid = {
		Prefix = "f",
		MaxLength = 12,
	},

	-- Кнопка у большого аквариума (Tank.Glass.PromptAttachment): открыть панель садка. Только
	-- хозяину базы; сервер ещё раз проверяет расстояние (не дальше MaxDistance + Slack).
	Prompt = {
		Action = "Открыть",
		Object = "Садок",
		HoldDuration = 0,
		MaxDistance = 10,
		Slack = 4,
	},

	-- Рыбы в витринах (клиент, TankWorldController): модель вида × мутации, длинная сторона —
	-- Fit studs (витрина 6.2), но не крупнее MaxScale; повёрнута к проходу на Yaw градусов.
	Display = {
		Fit = 5.2,
		MaxScale = 1.6,
		Yaw = 18,
		Range = 180, -- строить рыб базы, если камера ближе, studs …
		DropRange = 210, -- … и убирать, только когда дальше этого (без дребезга на границе)
		BuildPerCheck = 3, -- не больше стольких моделей рыб за одну проверку
		LifeRange = 70, -- ближе — рыбы тихо покачиваются (зацикленные твины; радужная — переливается) …
		LifeDrop = 80, -- … и замирают, только когда дальше этого (без дребезга на границе)
		TagShow = 28, -- надписи «+$4/с · $45 ▲» над витринами видны до стольких studs (дальше — каша) …
		TagRange = 45, -- … а их цены обновляются ближе этого (показалась — уже свежая)
		LockRange = 80, -- «🔒 Закрыто» над закрытыми витринами видно до стольких studs (от ворот двора)
		SignRange = 160, -- надпись над большим аквариумом видна до стольких studs
		EventRange = 120, -- всплески и искры событий витрин — только у баз ближе этого
		CheckEvery = 0.5, -- проверка расстояний, с (цепочка task.delay)
		GlassOccupied = 0.8, -- прозрачность стекла витрины с рыбой (шаблон — 0.66)
		TagEvery = 1, -- значения надписей витрин — раз в столько секунд (один таймер)
		MarketWordRange = 200, -- слово «РЫНОК +50%!» над рынком острова видно до стольких studs
		-- Тихая жизнь (ближе LifeRange): один зацикленный твин CFrame корня рыбы — Sine InOut,
		-- Reverses, бесконечно, случайная фаза; длина твина — случайно TimeMin..TimeMax секунд.
		Life = {
			Bob = 0.12, -- вверх-вниз ±, studs
			Turn = 6, -- поворот ±, градусов
			TimeMin = 2.4,
			TimeMax = 3.2,
		},
		-- Надпись витрины FxTankTag: Attachment на FishPoint + (0, Lift, −Forward) в осях витрины —
		-- над стеклом, перед его лицевой гранью (3.1 от центра) и ниже потолка галереи (13.15):
		-- из прохода взгляд на неё не идёт сквозь стекло (стекло прячет надписи за собой);
		-- BillboardGui Width × Height studs + PixelsX × PixelsY px (вблизи растёт с миром, у
		-- TagRange ещё читается), обводка букв Outline px.
		Tag = {
			Lift = 3.6,
			Forward = 3.6,
			Width = 4.6,
			Height = 1.5,
			PixelsX = 24,
			PixelsY = 8,
			Outline = 2,
			LockShare = 0.55, -- «🔒 Закрыто» над закрытой витриной: такая доля высоты надписи
		},
		-- Надпись садка FxTankSign: над передним краем Tank.Glass (Inset studs от него вглубь,
		-- Lift studs над верхом стекла — выше таблички «АКВАРИУМ»).
		Sign = {
			Lift = 4,
			Inset = 4,
			Width = 9,
			Height = 3.4,
			PixelsX = 110,
			PixelsY = 42,
			Outline = 2.5,
		},
		-- Слово «РЫНОК +50%!» (FxMarketWord): над вывеской «РЫБНЫЙ РЫНОК» — от точки кнопки
		-- ларька (SellPromptAttachment) на Up studs вверх и на Forward studs к покупателям.
		MarketWord = {
			Up = 20.5,
			Forward = 9,
			Width = 22,
			Height = 4.2,
			PixelsX = 120,
			PixelsY = 24,
			Outline = 3,
		},
		-- Эффекты событий витрин ("in" / "sold" / "swap").
		Fx = {
			Shrink = 0.25, -- "sold" / "swap": рыба сжимается до нуля за столько секунд
			Grow = 0.35, -- "in" / "swap": новая рыба вырастает из точки за столько секунд
			From = 0.15, -- … начиная с такой доли своего размера
			MaxEmitters = 2, -- ParticleEmitter одновременно на игрока — не больше
			Above = 0.4, -- искры и брызги — на столько studs над ВЕРХОМ витрины …
			Forward = 0.5, -- … и на столько перед лицевой гранью стекла (из прохода — не сквозь стекло)
			TagOut = 0.15, -- надпись проданной рыбы уходит за столько секунд
			Splash = 14, -- "in": брызг …
			Sparkle = 12, -- … и искр цвета редкости; "sold" / "swap": золотых искр
			Coins = 16, -- "Sold" у ларька: монеток у его весов
			FlashRange = 10, -- вспышка света у LightBar: радиус, studs …
			FlashBrightness = 4, -- … яркость …
			FlashTime = 0.6, -- … и сколько секунд вспыхивает и гаснет
			RiseFrom = -0.4, -- «+$45» продажи всплывает на столько studs ниже надписи витрины …
			Rise = 1.2, -- … поднимается на столько studs (потолок галереи — в 1.55 над надписью) …
			RiseTime = 1.2, -- … за столько секунд и тает
			RiseOutline = 2,
			RiseSize = { Width = 3.2, Height = 0.85, PixelsX = 40, PixelsY = 14 }, -- studs + px
			EmitterLife = 1.2, -- столько секунд живёт временный ParticleEmitter (его частицы — до 1.1 с)
		},
	},

	-- Слово садка над ведром у места рыбалки (только своя база).
	Pier = {
		Range = 40, -- видно до стольких studs
		PopRange = 30, -- «+$13» дохода всплывает, только если свой персонаж ближе этого к ведру …
		PopEvery = 5, -- … раз в столько секунд,
		Rise = 2.5, -- поднимается над словом на столько studs …
		PopTime = 1.2, -- … за столько секунд и тает
		Width = 4, -- BillboardGui слова, studs …
		Height = 1.4,
		PixelsX = 30, -- … + px (с камеры рыбалки, ≈ 13 studs, — ≈ 115 × 45 px на телефоне)
		PixelsY = 14,
		Lift = 0.3, -- низ слова — на столько studs над верхом ведра (и рыбьего хвоста в нём) …
		Out = 1.2, -- … и на столько дальше от места рыбалки: с камеры рыбалки — под поплавком и правее лески
		Outline = 2,
		PopSize = { Width = 2.2, Height = 0.6, PixelsX = 30, PixelsY = 12 }, -- «+$13», studs + px
		Splash = 12, -- прилёт рыбы в садок: брызг у края ведра
	},

	-- Панель садка (TankPanelController).
	Panel = {
		RowsTall = 2, -- рядов карточек на высоком экране …
		TallFrom = 600, -- … если HUD не ниже стольких px (на телефоне — один ряд)
		Tick = 1, -- цены, полоски роста и сумма садка обновляются раз в столько секунд
		WideCard = 150, -- на карточке шире стольких px — полное имя и «ПРОДАТЬ $45»
	},

	Texts = {
		-- Панель
		Title = "САДОК",
		Sell = "ПРОДАТЬ", -- на широкой карточке: «ПРОДАТЬ $45»; на телефоне — «💵 $45»
		Confirm = "ТОЧНО?",
		Max = "МАКС",
		Empty = "ПУСТО",
		EmptyHint = "Поймай рыбу!",
		Locked = "ЕЩЁ МЕСТО",
		LockedHint = "Скоро в магазине",
		MarketChip = "РЫНОК +{bonus}%",
		-- Штамп на карточке улова (CatchFx.tankStamp): что стало с рыбой
		Stamp = {
			stored = "В САДОК!",
			replaced = "ЗАМЕНА!",
			sold = "ПРОДАНА",
		} :: { [string]: string },
		-- Уведомления (клиент, NotifyController)
		FirstFish = "Твоя рыба приносит $ каждую секунду!", -- первая рыба за всё время
		Replaced = "Замена! «{new}» вместо «{old}» +{price}", -- рыба сильнее заменила слабую
		FullSold = "Садок полон — лови рыбу получше!", -- слабая продана сразу (раз за игру)
		Milestone = "Уже {money}! 🎉", -- (P2) рубежи EconomyConfig.Milestones
		-- Мир (TankService — таблички витрин, TankWorldController — надписи над витринами и садком,
		-- слово у ведра, всплывающие суммы, слово рынка; {price} / {amount} — TankRules.FormatMoney,
		-- {rate} — TankRules.FormatRate)
		SlotEmpty = "Пусто",
		SlotLocked = "🔒 Закрыто",
		TagValue = "{price} ▲", -- над витриной: цена сейчас, ещё растёт …
		TagMax = "{price} {max}", -- … и выросла до конца ({max} — Max, «МАКС»)
		TankCount = "🐠 {count}/{slots}", -- над большим аквариумом и над ведром
		Pop = "+{amount}", -- всплывающие суммы: продажа над витриной, доход над ведром
		MarketWord = "РЫНОК +{bonus}%!",
		-- Отказ продажи (TankEvent "Denied" { Reason, Text })
		Denied = {
			loading = "Загружаем твой садок…",
			nobase = "Сначала дождись своей базы",
			missing = "Этой рыбы уже нет",
			locked = "Эту рыбу сейчас не продать",
		} :: { [string]: string },
	},
}

return TankConfig
