--!strict
--[[
	MapConfig — размеры и раскладка карты: озеро, берег, центральный остров-хаб, мосты, места под базы.

	Кто читает:
	  • сборщик места (tools/builder/Map.luau) — по этим цифрам строит берег, озеро, хаб и мосты;
	  • сервер во время игры (уровень воды, высота земли и т.п.).

	ВАЖНО: модуль «чистый» — без require и без обращений к game/workspace, потому что его
	читает сборщик вне Roblox. Геометрия карты уже лежит в Place1.rbxl, поэтому после правки
	чисел здесь карту нужно пересобрать (tools/build.luau), иначе изменится только логика.

	Углы — в градусах. Точка на угле θ и радиусе r: (r·sin θ, y, r·cos θ), центр озера — (0, y, 0).
]]

local MapConfig = {
	-- Высоты (ось Y) -------------------------------------------------------------------
	GroundTop = 1, -- верх суши (трава и песок)
	WaterTop = 0, -- поверхность воды (кратно 4 — шаг сетки Terrain)
	LakeBottom = -16, -- дно озера (кратно 4)
	HubTop = 1.5, -- верх травы на центральном острове

	-- Озеро и суша ---------------------------------------------------------------------
	LakeRadius = 100, -- радиус озера (до берега)
	BeachWidth = 14, -- ширина песчаной полосы вокруг озера
	Cell = 8, -- размер «вокселя» береговой линии (кратно 4)
	InnerHalf = 128, -- половина стороны квадрата, где берег собирается из клеток
	LandHalf = 184, -- половина стороны всей суши
	OceanHalf = 520, -- до куда тянется океан вокруг суши
	BoundaryHalf = 216, -- невидимые стены (игрок может немного поплавать в океане)

	-- Центральный остров-хаб -----------------------------------------------------------
	HubRadius = 32,
	HubSandWidth = 6,

	-- Базы игроков ---------------------------------------------------------------------
	BaseCount = 8,
	BaseRadius = 100, -- корень базы стоит на линии берега, пирс уходит к центру
	BaseAngleOffset = 22.5, -- угол первой базы; базы стоят между мостами

	-- Мосты на хаб ---------------------------------------------------------------------
	BridgeAngles = { 0, 90, 180, 270 },
	BridgeWidth = 8,
}

return MapConfig
