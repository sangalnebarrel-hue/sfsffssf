--!strict
--[[
	MapConfig — раскладка мира «Рыбацкая долина»: огромное озеро в кольце гор, остров-деревня
	в центре, 8 баз по берегу, мосты, кольцевая дорога, реки и водопады.

	ВАЖНО: эти числа читает сборщик мира (tools/builder/*, tools/terrain/*) — по ним он один раз
	генерирует рельеф Terrain и детали, которые уже лежат в Place1.rbxl. Игра во время работы
	берёт отсюда только уровень воды/земли. Правка чисел здесь в Studio сама по себе карту не меняет.
	Что можно двигать прямо в Studio:
	  • Workspace.Map.BaseSlots — метки, где встают базы (сервер берёт позиции оттуда).
	Модуль «чистый» (без require и без обращений к game/workspace) — его читает Lune вне Roblox.

	Углы — в градусах. Точка на угле θ и радиусе r: (r·sin θ, y, r·cos θ), центр озера — (0, y, 0).
]]

local MapConfig = {
	-- Высоты (ось Y) -------------------------------------------------------------------
	WaterTop = 0, -- поверхность воды озера и рек (кратно 4 — сетка Terrain)
	GroundTop = 4, -- ровные площадки баз, кольцевая дорога, площадь деревни
	LakeDepth = 30, -- глубина озера в центре (дно у берега мельче)

	-- Озеро ------------------------------------------------------------------------------
	LakeRadius = 220, -- радиус береговой линии
	BeachWidth = 18, -- песчаный пляж за линией берега

	-- Центральный остров-деревня ---------------------------------------------------------
	HubRadius = 64, -- радиус острова по воде
	HubPlazaRadius = 46, -- ровная площадь на высоте GroundTop

	-- Базы игроков -------------------------------------------------------------------------
	BaseCount = 8,
	BaseRadius = 220, -- корень базы на линии берега, пирс уходит к центру
	BaseAngleOffset = 22.5, -- угол первой базы; базы стоят между мостами
	BasePlotDepth = 84, -- ровная терраса базы вглубь суши от берега
	BasePlotHalfWidth = 44, -- полуширина террасы

	-- Мосты на остров -------------------------------------------------------------------
	BridgeAngles = { 0, 90, 180, 270 },
	BridgeWidth = 10,

	-- Кольцевая дорога за базами -------------------------------------------------------
	RingRoadRadius = 322,
	RoadWidth = 14,

	-- Долина и горы -------------------------------------------------------------------------
	ValleyRadius = 420, -- до сюда пологие луга и лес
	MountainRadius = 620, -- кольцо гор между ValleyRadius и этим радиусом
	MountainHeight = 230, -- высота пиков
	SnowLine = 190, -- выше — снег
	WorldHalf = 704, -- рельеф генерируется в квадрате ±WorldHalf
	BoundaryRadius = 560, -- невидимая стена (игроки не уходят за горы)

	-- Реки с водопадами (угол, откуда река течёт с гор в озеро) ---------------------
	Rivers = { 45, 225, 315 }, -- только диагонали: на осях мосты, между ними базы
	RiverWidth = 18,
}

return MapConfig
