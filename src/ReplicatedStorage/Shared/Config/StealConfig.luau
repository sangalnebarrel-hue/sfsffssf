	Prompt = {
		Action = "Украсть",
		MaxDistance = 6, -- витрины в 11 studs друг от друга: шаг назад от витрины — кнопки нет
		Slack = 2, -- сервер прощает ещё столько: 8 < 10 — никогда сквозь заднюю стену галереи
	},
	-- Удержание: время считает сервер (от PromptButtonHoldBegan).
	Hold = {
		Tolerance = 0.5, -- Triggered раньше нужного на столько с ещё засчитан (сервер ждёт до t0 + need)
		Deadline = 1.5, -- Triggered так и не пришёл через need + столько с — кража сорвана ("deadline")
		Grace = 0.3, -- отпустил при ≥ need − Tolerance: столько с ждём его Triggered
		NoReply = 1.0, -- клиент: нет ни Hold, ни Denied столько с после начала — кольцо гаснет …
		NoReplySlack = 0.4, -- … или за пинг (туда и обратно) + столько с, если связь медленнее
	},
	-- Вынос рыбы за ограду.
	Carry = {
		Enabled = true, -- false: рыба переходит в конце удержания (буквально по заданию; §9 R1)
		SpeedFactor = 0.85, -- вор с рыбой идёт медленнее
		Timeout = 25, -- столько с на вынос, потом рыба «уплывает домой»
		ExitMargin = 2, -- за край участка на столько studs — рыба вора
		-- «Дырявый бюджет» пути (§4.4, BE-9): за тик бюджет пополняется на allowed × dt × Rate (не
		-- выше cap = allowed × CapSeconds + CapSlack) и тратится на пройденное по горизонтали.
		Speed = {
			Rate = 1.15,
			CapSeconds = 1.5, -- полторы секунды ходьбы в запасе: задержка сети, потом рывок
			CapSlack = 6,
			Debt = 4, -- бюджет ниже −Debt — рыба вернулась ("speed")
			-- За один тик дальше стольких studs — рыба вернулась ("speed"); тик сервера длиннее Tick —
			-- предел больше на путь честного вора за лишнее время (заминка сервера — не его вина).
			Teleport = 24,
			Start = 6, -- бюджет в начале выноса (не полный: ×2 ускорение не добежит до ограды; A2-01)
			FactorGrace = 0.5, -- allowed — самая быстрая скорость за последние столько с (WalkSpeed доходит с задержкой)
		},
	},
	-- Хозяин ближе стольких studs (по горизонтали, HRP ↔ HRP) — вор пойман.
	Tag = {
		Range = 6,
	},
	Tick = 0.1, -- шаг наблюдателя, пока идёт хоть одна кража или бежит собака (иначе цикла нет)
	-- Куда бежать с рыбой (красная дорожка вора, StealRules.NearestExit; studs базы): ворота
	-- (0, PlotFront − ExitMargin), боковая ограда (±(PlotHalfWidth + ExitMargin), z от SideFrom до
	-- SideTo — дальше терраса дома) и арки в живой изгороди сзади (±ArchX, PlotFront + PlotDepth +
	-- ExitMargin).
	Exits = {
		SideFrom = 20,
		SideTo = 121,
		ArchX = 40,
	},
	-- Честные лимиты (§1.5, D5, D21).
	Limits = {
		ThiefCooldown = 30, -- после удачной кражи вор ждёт столько с
		FailCooldown = { 3, 10, 30 }, -- после 1-го / 2-го / 3-го срыва по своей вине за FailWindow; "early" — сразу последнее
		FailWindow = 60,
		TagCooldown = 20, -- пойманный хозяином вор не крадёт на этой базе столько с
		VictimImmunity = 90, -- жертва после кражи защищена столько с ("after")
		VictimMax = 2, -- не больше стольких краж у жертвы за VictimWindow; 2-я начинает "rest" (DC-06)
		VictimWindow = 600,
		MinFishToRob = 3, -- у жертвы меньше стольких активных рыб — красть нельзя
		FreshCatch = 30, -- рыбу, пойманную меньше стольких с назад, украсть нельзя (DC-08)
		RichRatio = 3, -- нельзя, если доход вора больше RichRatio × доход жертвы… (0 — выключено; DC-09)
		RichMin = 20, -- … и вор получает хотя бы столько $/с
		StartBurst = 3, -- лимит начал удержания: запас жетонов …
