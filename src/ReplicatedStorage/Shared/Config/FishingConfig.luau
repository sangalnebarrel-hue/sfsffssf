--!strict
--[[
	FishingConfig — время, расстояния и сложность рыбалки (баланс Этапа 2).

	Порядок рыбалки:
	  1) игрок стоит у точки рыбалки на своём пирсе с удочкой в руке и жмёт «Забросить»;
	  2) поплавок летит CastFlightTime секунд, потом ждём поклёвку BiteDelay (делится на
	     BiteSpeed удочки);
	  3) клюёт — есть BiteWindow секунд, чтобы нажать «Подсечь» (раньше поклёвки — рыба
	     пугается и уплывает);
	  4) мини-игра: стрелка бегает по полосе туда-обратно, надо нажать, когда она в зелёной
	     зоне, Hits раз подряд (промах — рыба срывается). Чем редче рыба, тем уже зона
	     и быстрее стрелка (Minigame[редкость]);
	  5) поймал — карточка улова, +1 в улове; рыба выпрыгивает из воды у поплавка и за LeapTime
	     секунд долетает до рыбака — и остаётся над его головой на HoldFishTime[редкость] секунд
	     (FishingRules.HoldFishTime: чем реже рыба, тем дольше ею можно хвастаться).
	Эффекты в мире (брызги, круги на воде, прыжок рыбы, столб света) — таблица Fx
	(FishingFxController), их цвета — UIConfig.
	Модуль «чистый» (без require).
]]

export type MinigameRule = {
	ZoneWidth: number, -- ширина зелёной зоны, доля полосы (0..1)
	Speed: number, -- скорость стрелки, полос в секунду (0.8 — из конца в конец за 1,25 с)
	Hits: number, -- сколько раз подряд попасть в зону
}

local FishingConfig = {
	-- Где можно рыбачить: в радиусе SpotRadius стадов (по горизонтали) от точки рыбалки
	-- (FishingSpot) своей базы. Отошёл дальше KeepRadius во время рыбалки — леска сматывается.
	SpotRadius = 12,
	KeepRadius = 18,
	SpotMaxHeight = 10, -- насколько выше/ниже точки может стоять персонаж

	CastCooldown = 0.8, -- пауза между окончанием рыбалки и новым забросом, с
	CastFlightTime = 0.7, -- полёт поплавка до воды, с
	-- Поплавок падает не прямо по оси пирса, а правее (на CastSide studs вправо, если смотреть
	-- с пирса в лагуну): камера стоит за спиной рыбака, и поплавок, всплеск и прыжок рыбы
	-- оказываются на экране правее его головы, а не за ней.
	CastSide = { Min = 4, Max = 7 },
	BiteDelay = { Min = 2.5, Max = 6 }, -- ожидание поклёвки после приводнения, с
	BiteWindow = 1.8, -- сколько клюёт (успеть нажать «Подсечь»), с
	MinigameTimeout = 12, -- на всю мини-игру, с (не успел — рыба уходит)
	TapInterval = 0.15, -- сервер не принимает нажатия в мини-игре чаще, с
	-- Нажатие мимо зоны в первые HookTapGrace секунд мини-игры — это второй тап двойного
	-- нажатия «Подсечь», а не промах: оно просто не считается (попадание считается).
	HookTapGrace = 0.35,

	-- Сеть: нажатие приходит на сервер с задержкой. Клиент присылает, сколько секунд мини-игры
	-- прошло у него (считает с момента, когда получил старт); сервер принимает это время, если
	-- оно не позже серверного и не раньше больше чем на MaxLag — это весь пинг туда-обратно
	-- (0,6 с хватает и мобильному интернету). Для подсечки сервер прощает LatencyGrace после
	-- конца поклёвки.
	MaxLag = 0.6,
	-- Не меньше MaxLag: подсечка в последний миг поклёвки (и нажатие в последний миг
	-- мини-игры) приходит на сервер через весь пинг туда-обратно.
	LatencyGrace = 0.7,

	-- Новая зелёная зона после попадания ставится не ближе MinZoneJump к стрелке;
	-- край зоны не ближе ZoneMargin к концу полосы.
	MinZoneJump = 0.3,
	ZoneMargin = 0.03,

	Minigame = {
		Common = { ZoneWidth = 0.3, Speed = 0.8, Hits = 1 },
		Rare = { ZoneWidth = 0.24, Speed = 0.95, Hits = 1 },
		Epic = { ZoneWidth = 0.2, Speed = 1.1, Hits = 2 },
		Legendary = { ZoneWidth = 0.17, Speed = 1.25, Hits = 2 },
		Mythic = { ZoneWidth = 0.14, Speed = 1.4, Hits = 3 },
	} :: { [string]: MinigameRule },

	-- Поймал: рыба выпрыгивает из воды у поплавка и дугой летит к рыбаку (её рисуют клиенты),
	-- а рыба над головой (сервер) появляется, когда прыжок закончился.
	LeapTime = 1, -- прыжок рыбы от воды до головы рыбака, с
	-- Пойманная рыба над головой рыбака (после прыжка), с — по редкости; читать через
	-- FishingRules.HoldFishTime(редкость). Каждое время дольше карточки улова этой редкости
	-- (рыбак успевает увидеть свой трофей над головой, а соседи — что у него в руках).
	HoldFishTime = { Common = 4, Rare = 4.5, Epic = 5.5, Legendary = 6.5, Mythic = 8 } :: { [string]: number },
	HeldFishGap = 0.5, -- зазор между макушкой и рыбой над головой, studs

	-- Тексты для игрока по коду причины — одни и те же у сервера и клиента: сервер присылает
	-- их в "Denied" / "Lost" (Text), клиент (FishingController) берёт отсюда, если текста нет.
	-- Пустая строка — причина без подсказки.
	Texts = {
		Denied = {
			far = "Иди в сверкающий круг на краю пирса", -- и подсказка новичку (FishingController)
			nobase = "Сначала дождись своей базы",
			busy = "Удочка уже заброшена",
			cooldown = "",
			norod = "Возьми удочку в руки",
		},
		Lost = {
			early = "Слишком рано — рыба испугалась",
			late = "Слишком поздно — рыба уплыла",
			miss = "Мимо! Рыба сорвалась с крючка",
			timeout = "Время вышло — рыба ушла",
		},
		Idle = {
			stop = "Леска смотана",
			moved = "Слишком далеко от края пирса — леска смотана",
			unequipped = "Удочка убрана — леска смотана",
			base = "Леска смотана",
		},
	} :: { [string]: { [string]: string } },

	-- Эффекты рыбалки в мире (FishingFxController; только на клиенте, у каждого игрока свои).
	Fx = {
		-- Дальше Range studs от своего персонажа эффектов чужой рыбалки не видно (кроме столба
		-- света легендарной и мифической рыбы): брызги, круги и прыжки не создаются вовсе.
		Range = 250,
		MaxEmitters = 2, -- ParticleEmitter'ов на одного рыбака одновременно, не больше

		-- Круги на воде вокруг поплавка: пока ждём поклёвку — раз в RippleEvery секунд,
		-- пока тянем — чаще; на заброс, поклёвку и улов — пачкой по 2–3.
		RippleEvery = 1.2,
		ReelRippleEvery = 0.45,
		ReelSprayEvery = 0.25, -- брызги вокруг поплавка, пока тянем, с
		-- Спокойные круги (ожидание, вытаскивание) — только у рыбаков ближе AmbientRange studs
		-- (у своего поплавка — всегда) и не больше MaxRings кругов рыбака на воде сразу.
		AmbientRange = 80,
		MaxRings = 4,

		-- Прыжок пойманной рыбы: высота дуги — доля расстояния от поплавка до головы
		-- (не ниже LeapMinHeight и не выше LeapMaxHeight studs: выше рыба уходит за верх экрана
		-- телефона при обычной камере за спиной). Рыба делает LeapSpins оборотов и заканчивает
		-- их к доле LeapSpinEnd полёта — на вершине дуги она уже боком к камере; дуга выгнута
		-- вбок на LeapBow studs (вправо от камеры смотрящего), чтобы из-за спины читалась кривая.
		LeapHeight = 0.3,
		LeapMinHeight = 6,
		LeapMaxHeight = 10,
		LeapSpins = 1,
		LeapSpinEnd = 0.55,
		LeapBow = 3,
		-- Прыжок долетел, а рыбы над головой ещё нет (сеть): ждём её не дольше, с.
		HandoffWait = 0.6,

		DiveTime = 0.9, -- сорвавшаяся рыба мелькает хвостом и уходит под воду, с
		DiveScale = 1, -- … в натуральную величину (её должно быть видно с пирса)

		-- Столб света над рыбаком (легендарная и мифическая рыба): сколько секунд и какой высоты.
		PillarTime = { Legendary = 2.8, Mythic = 3.5 } :: { [string]: number },
		-- … у ДРУГИХ игроков: для них столб — главный знак «там поймали редкую рыбу», он живёт
		-- дольше и позже начинает гаснуть (у самого рыбака его почти весь срок закрывает карточка).
		PillarTimeOther = { Legendary = 5, Mythic = 7 } :: { [string]: number },
		PillarHeight = { Legendary = 90, Mythic = 130 } :: { [string]: number },
		ConfettiCount = 60, -- конфетти над рыбаком (легендарная и мифическая рыба)
		-- Искр в секунду вокруг рыбы над головой (обычной рыбе — без искр; у рыбы с мутацией —
		-- не меньше MutationAuraRate, цветами мутации).
		AuraRate = { Rare = 7, Epic = 11, Legendary = 16, Mythic = 22 } :: { [string]: number },
		MutationAuraRate = 10,
	},
}

return FishingConfig
